# Copy to .env (or set these in your host's dashboard). None are required to try the app locally.

NODE_ENV=production
PORT=3000

# Public address of the app, used in email links. Must be https in production.
APP_URL=https://hindsight.example.com

# Where the SQLite database lives. Point this at a persistent disk or volume.
DATA_DIR=/data

# Comma-separated emails that get moderator access (sign up with one of them first).
ADMIN_EMAILS=you@example.com

# Email. Without SMTP_URL, emails are printed to the server log and email verification is not required.
# With it, new accounts must confirm their email before sharing stories or sending questions.
# Example (Resend): smtps://resend:YOUR_API_KEY@smtp.resend.com:465
SMTP_URL=
MAIL_FROM=Hindsight <no-reply@hindsight.example.com>
SUPPORT_EMAIL=support@hindsight.example.com

# Set to false to skip loading the six labeled example stories on a brand-new database.
SEED_SAMPLES=true

# Number of reverse proxies in front of the app (Render, Fly and Railway use 1).
TRUST_PROXY=1
